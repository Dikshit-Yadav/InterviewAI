{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Install backend runtime dependencies",
			"type": "shell",
			"command": "npm",
			"args": [
				"--prefix",
				"backend",
				"install",
				"--save",
				"multer",
				"pdf-parse@^1.1.1",
				"mammoth"
			],
			"isBackground": false
		},
		{
			"label": "Temporary frontend build validation",
			"type": "shell",
			"command": "npm",
			"args": [
				"--prefix",
				"frontend",
				"run",
				"build"
			],
			"isBackground": false
		}
	]
}