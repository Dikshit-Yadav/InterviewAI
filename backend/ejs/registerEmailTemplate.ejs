<!DOCTYPE html>

<html>
<body style="margin:0;padding:24px;background:#F0E9DC;font-family:Arial,sans-serif;color:#292A23;">
<div style="max-width:480px;margin:auto;background:#F7F2E8;border:1px solid #D5CCBC;">
<div style="padding:20px;background:#343A2B;color:#F0E9DC;font-size:22px;font-weight:bold;">
InterviewAI
</div>

<div style="padding:24px;">
  <h2 style="margin:0 0 12px;color:#292A23;">Verification code</h2>

  <p style="font-size:14px;line-height:1.6;color:#55564A;">
    Use this code to <%= action %> your InterviewAI account.
  </p>

  <div style="padding:18px;text-align:center;background:#E8DFD0;border:1px solid #D5CCBC;font-size:28px;font-weight:bold;letter-spacing:6px;color:#343A2B;">
    <%= code %>
  </div>

  <p style="font-size:13px;line-height:1.6;color:#656657;">
    This code expires in 10 minutes. If you didn't request it, ignore this email.
  </p>
</div>


</div>
</body>
</html>